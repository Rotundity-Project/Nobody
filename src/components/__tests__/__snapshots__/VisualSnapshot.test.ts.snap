exports[`visual snapshots > MainMenu snapshot 1`] = `"<div data-v-c04b848d="" class="main-menu-shell min-h-screen px-4 py-8 sm:px-6 sm:py-10"><div data-v-c04b848d="" class="main-menu-guide">建议流程：新游戏 -&gt; 选择剧本 -&gt; 进入主界面推进剧情</div><div data-v-c04b848d="" class="main-menu-frame mx-auto w-full max-w-[1320px]"><aside data-v-c04b848d="" class="menu-left-rail"><button data-v-c04b848d="" type="button" data-testid="new-game-btn" class="menu-btn menu-btn-primary">新游戏</button><button data-v-c04b848d="" type="button" data-testid="continue-game-btn" class="menu-btn" aria-expanded="true" aria-controls="recent-save-card">读取存档</button><button data-v-c04b848d="" type="button" data-testid="llm-settings-btn" class="menu-btn">LLM 设置</button><button data-v-c04b848d="" type="button" data-testid="open-audio-btn" class="menu-btn" aria-label="展开音量控制，当前音量 55%，BGM 开，音效 开" aria-describedby="quick-volume-status" aria-controls="main-menu-audio-panel" aria-expanded="false">游戏设置</button><p data-v-c04b848d="" id="quick-volume-status" data-testid="quick-volume-status" class="menu-volume-pill" role="status" aria-live="polite" aria-atomic="true">当前 55%</p></aside><main data-v-c04b848d="" class="menu-main-stage"><header data-v-c04b848d="" class="main-menu-header"><p data-v-c04b848d="" class="main-menu-en-title">NOBODY</p><p data-v-c04b848d="" class="main-menu-cn-title">小人物</p><div data-v-c04b848d="" class="main-menu-seal" aria-hidden="true">无名印</div></header><section data-v-c04b848d="" class="menu-card mt-6"><h2 data-v-c04b848d="" class="menu-card-title">最近存档</h2><p data-v-c04b848d="" id="no-save-hint" data-testid="no-save-hint" class="mt-2 text-sm leading-6 text-[#6a655d]" role="status" aria-live="polite" aria-atomic="true">暂无可用存档，可先开始新游戏创建进度。</p><!--v-if--><!--v-if--><!--v-if--></section></main></div><div data-v-c04b848d="" class="menu-overlay"><section data-v-c04b848d="" id="recent-save-card" data-testid="recent-save-card" class="menu-dialog" aria-busy="false"><header data-v-c04b848d="" class="menu-dialog-header"><h2 data-v-c04b848d="" class="menu-card-title">读取存档</h2><button data-v-c04b848d="" type="button" class="menu-inline-btn">关闭</button></header><div data-v-c04b848d="" class="menu-dialog-body"><aside data-v-c04b848d="" class="menu-dialog-left"><p data-v-c04b848d="" id="save-actions-heading" class="menu-sub-title">存档槽位</p><div data-v-c04b848d="" data-testid="save-actions-group" class="mt-2 grid gap-2" role="group" aria-labelledby="save-actions-heading" aria-describedby="no-save-hint"><p data-v-c04b848d="" class="text-xs text-[#6a655d]">暂无存档槽位</p></div><button data-v-c04b848d="" type="button" data-testid="refresh-save-btn" class="menu-btn mt-3 text-sm disabled:cursor-not-allowed disabled:opacity-60" aria-label="刷新存档，尚未执行刷新" aria-controls="recent-save-card">刷新存档</button><button data-v-c04b848d="" type="button" class="menu-inline-btn mt-2">打开完整存档列表</button></aside><section data-v-c04b848d="" class="menu-dialog-right"><p data-v-c04b848d="" class="menu-sub-title">存档信息</p><p data-v-c04b848d="" class="mt-2 text-sm text-[#6a655d]">请选择左侧存档槽。</p><div data-v-c04b848d="" class="mt-4 flex flex-wrap gap-2"><button data-v-c04b848d="" type="button" data-testid="recent-save-btn" class="menu-btn menu-btn-primary text-sm disabled:cursor-not-allowed disabled:opacity-60" disabled="" aria-label="继续最近存档，当前没有可用存档" aria-describedby="no-save-hint">继续最近存档</button><!--v-if--></div></section></div></section></div><!--v-if--><l-l-m-config-dialog-stub data-v-c04b848d="" isopen="false"></l-l-m-config-dialog-stub></div>"`;

