exports[`visual snapshots > ScriptSelector snapshot 1`] = `"<div data-v-3d1d1551="" class="script-shell min-h-screen px-4 py-8 sm:px-6 sm:py-10"><div data-v-3d1d1551="" class="script-paper mx-auto w-full max-w-[1200px] rounded-2xl p-5 sm:p-8"><header data-v-3d1d1551="" class="script-header"><div data-v-3d1d1551=""><h1 data-v-3d1d1551="" class="script-main-title">NOBODY</h1><p data-v-3d1d1551="" class="script-cn-subtitle">小人物</p><p data-v-3d1d1551="" class="script-sub-title">CHOOSE YOUR PATH · 选择剧本类型</p></div><button data-v-3d1d1551="" type="button" class="script-seal" title="轻触印章，聆听天机"><span data-v-3d1d1551="">择道</span></button></header><!--v-if--><p data-v-3d1d1551="" class="script-flow-hint">第 1 步：选择剧本类型</p><section data-v-3d1d1551="" class="mt-4" data-testid="script-type-container"><div data-v-3d1d1551="" class="script-grid"><button data-v-3d1d1551="" type="button" class="script-type-card" data-testid="script-type-custom"><div data-v-3d1d1551="" class="script-type-head"><span data-v-3d1d1551="" class="script-type-icon" aria-hidden="true">笔</span><h3 data-v-3d1d1551="" class="script-type-title">自定义剧本</h3></div><p data-v-3d1d1551="" class="script-type-desc">加载自定义 JSON 剧本文件</p><p data-v-3d1d1551="" class="script-type-action"><span data-v-3d1d1551="" class="script-positive">选择文件</span>后导入剧本</p><!--v-if--></button><button data-v-3d1d1551="" type="button" class="script-type-card" data-testid="script-type-random_generated"><div data-v-3d1d1551="" class="script-type-head"><span data-v-3d1d1551="" class="script-type-icon" aria-hidden="true">鱼</span><h3 data-v-3d1d1551="" class="script-type-title">随机生成</h3></div><p data-v-3d1d1551="" class="script-type-desc">使用 AI 生成随机修仙世界</p><p data-v-3d1d1551="" class="script-type-action"><span data-v-3d1d1551="" class="script-positive">生成</span>专属修仙世界</p><!--v-if--></button><button data-v-3d1d1551="" type="button" class="script-type-card" data-testid="script-type-existing_novel"><div data-v-3d1d1551="" class="script-type-head"><span data-v-3d1d1551="" class="script-type-icon" aria-hidden="true">卷</span><h3 data-v-3d1d1551="" class="script-type-title">现有小说</h3></div><p data-v-3d1d1551="" class="script-type-desc">从现有修仙小说导入剧本</p><p data-v-3d1d1551="" class="script-type-action"><span data-v-3d1d1551="" class="script-positive">导入</span>小说并选定主角</p><!--v-if--></button></div><p data-v-3d1d1551="" class="script-tip">选择一种方式开始你的修仙之旅。</p></section><!--v-if--><!--v-if--><!--v-if--><footer data-v-3d1d1551="" class="script-footer mt-6"><button data-v-3d1d1551="" type="button" data-testid="back-btn" class="script-btn">返回</button><button data-v-3d1d1551="" type="button" data-testid="confirm-script-btn" disabled="" class="script-btn script-btn-primary">开始旅程</button></footer><p data-v-3d1d1551="" class="script-watermark" aria-hidden="true">小人物</p></div><!--v-if--></div>"`;
